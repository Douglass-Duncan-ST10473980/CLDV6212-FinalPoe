# Copy this file to ".env" in the repository root and fill in the values.
# The real .env file holds secrets and must never be committed to GitHub.

# Connection string for the Azure Storage account that hosts the staff-docs File Share.
# Azure Portal -> storage account -> Security + networking -> Access keys -> Connection string
FileShareStorage=

# Secret key used by the API Gateway to sign JWT tokens. Use a long random value
# (at least 32 characters). Generate one with: openssl rand -base64 48
JWT_KEY=