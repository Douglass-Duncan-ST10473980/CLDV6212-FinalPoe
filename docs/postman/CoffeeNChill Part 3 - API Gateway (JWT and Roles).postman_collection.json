              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains a JWT\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
